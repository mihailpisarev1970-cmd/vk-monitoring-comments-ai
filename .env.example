# ===== VK =====
# Идентификатор standalone-приложения (https://dev.vk.com)
VK_APP_ID=0
# Сервисный ключ доступа приложения (не токен личной страницы!)
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# ===== LLM (AiDostup, OpenAI-compatible) =====
AIDOSTUP_BASE_URL=https://aidostup.site/v1
AIDOSTUP_API_KEY=
AIDOSTUP_MODEL=
# Модель для генерации комментариев (если пусто — используется AIDOSTUP_MODEL)
AIDOSTUP_COMMENT_MODEL=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== PostgreSQL =====
# 127.0.0.1 обязательно: на Windows localhost может резолвиться в ::1
# и конфликтовать с локально установленным PostgreSQL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vk_monitor
POSTGRES_USER=vk_monitor
POSTGRES_PASSWORD=vk_monitor_pass
DATABASE_URL=postgresql+asyncpg://vk_monitor:vk_monitor_pass@127.0.0.1:5432/vk_monitor

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Application =====
APP_ENV=local
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
